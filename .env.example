# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Loaded automatically by rag/env.py -- no `export` needed.

# Required: generation, query rewriting, the relevance gate, and both
# evaluations. Nothing else needs a key -- embedding and indexing run locally.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it OpenAlex allows $0.10/day (~1,000 requests), which is
# enough for a full harvest (50 requests) but not for iterating on the queries.
# A free key raises it 10x. Sent as an Authorization header, never as a query
# parameter -- a key in a query string leaks into access logs and cache
# filenames.
OPENALEX_API_KEY=

# Optional overrides; defaults match docker-compose.yml.
# QDRANT_URL=http://localhost:6333
# POSTGRES_DSN=postgresql://artmat:artmat@localhost:5432/artmat
# POSTGRES_PASSWORD=artmat
# GRAFANA_PASSWORD=admin

# Exact answer cache. Disable for evaluations or debugging. Bump the namespace
# whenever the corpus/index changes so old answers cannot survive a data update.
# Prompt, model, answer style, rewrite setting, and passage count are already
# included automatically in each cache key.
# EXACT_CACHE_ENABLED=true
# EXACT_CACHE_NAMESPACE=corpus-v1

# Production retrieval diversifies passages after the relevance top five.
# These defaults preserve exact top-five retrieval while limiting repeated
# manufacturer series in the remaining context slots.
# MMR_CANDIDATES=32
# MMR_LAMBDA=0.95
# MMR_MAX_PER_DOC=2
# MMR_MAX_PER_FAMILY=2
# MMR_RELEVANCE_HEAD=5

# Conservative post-retrieval model routing. Only single-source specification
# lookups use the cheap model; comparison, risk, ageing and cross-source
# questions stay on GENERATE_MODEL. Disable to reproduce the all-Sonnet path.
# MODEL_ROUTING_ENABLED=true
# SIMPLE_GENERATE_MODEL=claude-haiku-4-5

# --- cloud deployment -------------------------------------------------------
# Set these instead of the localhost defaults to point the same code at managed
# services. See DEPLOY.md. Unset, everything runs against docker-compose.
# QDRANT_URL=https://<cluster>.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# POSTGRES_DSN=postgresql://user:pass@<host>-pooler.neon.tech/artmat?sslmode=require

# Optional. Sent as the `mailto` in the scrapers' User-Agent and to OpenAlex's
# polite pool. Left empty, requests go through anonymously -- slower, still
# allowed. Not hardcoded, because an address committed to a public repository
# is an address in every scraper's corpus.
CONTACT_EMAIL=
