# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Loaded automatically by rag/env.py -- no `export` needed.

# Required: generation, query rewriting, the relevance gate, and both
# evaluations. Nothing else needs a key -- embedding and indexing run locally.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it OpenAlex allows $0.10/day (~1,000 requests), which is
# enough for a full harvest (50 requests) but not for iterating on the queries.
# A free key raises it 10x. Sent as an Authorization header, never as a query
# parameter -- a key in a query string leaks into access logs and cache
# filenames.
OPENALEX_API_KEY=

# Optional overrides; defaults match docker-compose.yml.
# QDRANT_URL=http://localhost:6333
# POSTGRES_DSN=postgresql://artmat:artmat@localhost:5432/artmat
# POSTGRES_PASSWORD=artmat
# GRAFANA_PASSWORD=admin

# --- cloud deployment -------------------------------------------------------
# Set these instead of the localhost defaults to point the same code at managed
# services. See DEPLOY.md. Unset, everything runs against docker-compose.
# QDRANT_URL=https://<cluster>.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# POSTGRES_DSN=postgresql://user:pass@<host>-pooler.neon.tech/artmat?sslmode=require
