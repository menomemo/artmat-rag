# Streamlit Community Cloud has no environment variables. It reads this file --
# pasted into the app's "Secrets" box in the web console, not committed -- and
# exposes it as `st.secrets`, which app/secrets.py copies into os.environ so the
# rest of the code stays environment-driven.
#
# Copy to .streamlit/secrets.toml for local testing of the deployed path.
# That filename is gitignored; this one is not.

ANTHROPIC_API_KEY = "sk-ant-..."

# Qdrant Cloud: the cluster URL includes the port, and the key is a separate
# value from the console's "API keys" tab.
QDRANT_URL = "https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY = "..."
QDRANT_COLLECTION = "artmat"

# Neon: use the *pooled* connection string. Streamlit reruns the script on
# every widget interaction and each rerun opens a connection; the direct
# endpoint runs out of them faster than the pooler does.
POSTGRES_DSN = "postgresql://user:pass@ep-xxxx-pooler.eu-central-1.aws.neon.tech/artmat?sslmode=require"

# Keep published evaluation and production defaults aligned. Turn either on
# only when the corresponding retrieval/answer evaluation has been rerun.
MODEL_ROUTING_ENABLED = "false"
PRODUCTION_DIVERSITY_ENABLED = "false"
