FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    FASTEMBED_CACHE_PATH=/opt/fastembed \
    HF_HOME=/opt/hf

RUN useradd --create-home --uid 1000 user \
    && mkdir -p /opt/fastembed /opt/hf \
    && chown -R user:user /opt/fastembed /opt/hf

WORKDIR /home/user/app

COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt

COPY --chown=user:user . .
USER user

# Build-time download makes the first public request load only the ONNX model
# into memory; it does not wait on a 130 MB network fetch.
RUN python -c "from fastembed import TextEmbedding, SparseTextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5'); SparseTextEmbedding('Qdrant/bm25')"

EXPOSE 7860
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "7860"]
